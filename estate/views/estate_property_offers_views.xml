<?xml version="1.0"?>
<odoo>

	<record id="estate_property_offer_form" model="ir.ui.view">
		<field name="name">estate.property.offer.form</field>
		<field name="model">estate.property.offer</field>
		<field name="arch" type="xml">
			<form string="Property Offers">
				<sheet>
					<group>
						<field name="price"/>
						<field name="partner_id" string="Partner"/>
						<field name="validity"/>
						<field name="date_deadline" string="Deadline"/>
						<field name="status"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>
	
	<record id="estate_property_offer_list" model="ir.ui.view">
		<field name="name">estate.property.offer.list</field>
		<field name="model">estate.property.offer</field>
		<field name="arch" type="xml">
			<list string="Offers List">
				<field name="price"/>
				<field name="partner_id" string="Partner"/>
				<field name="date_deadline" string="Deadline"/>
				<field name="validity"/>
				<button name="accept_offer" type="object" icon="fa-check"/>
				<button name="refuse_offer" type="object" icon="fa-times"/>
				<field name="status"/>
			</list>
		</field>
	</record>
</odoo>
